---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import LinkblogCard from "@/components/LinkblogCard.astro";
import Hr from "@/components/Hr.astro";
import postFilter from "@/utils/postFilter";
// import IconRss from "@/assets/icons/IconRss.svg"; // TODO: enable rss feed
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";

const posts = await getCollection("blog", postFilter);
const links = await getCollection("linkblog", ({ data }) => !data.draft);
const recentEntries = [...posts, ...links]
  .filter(entry => entry.collection !== "blog" || !entry.data.featured)
  .sort(
    (first, second) =>
      second.data.pubDatetime.getTime() - first.data.pubDatetime.getTime()
  );
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index">
    <section id="hero" class="pt-8 pb-6">
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        Hi, I'm Silvestre
      </h1>
      <!-- <a
        target="_blank"
        href="/rss.xml"
        class="inline-block"
        aria-label="rss feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
          class="scale-125 stroke-accent stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">RSS Feed</span>
      </a> -->

      <p>and you've found my corner of the web.</p>
      {
        // only display if at least one social link is enabled
        SOCIALS.length > 0 && (
          <div class="mt-4 flex flex-col sm:flex-row sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">Social Links:</div>
            <Socials />
          </div>
        )
      }
    </section>

    <Hr />

    <section id="recent-posts" class="pt-12 pb-6">
      <h2 class="text-2xl font-semibold tracking-wide">Recent</h2>
      <ul>
        {
          recentEntries.map(
            (data, index) =>
              index < SITE.postPerIndex &&
              (data.collection === "blog" ? (
                <Card variant="h3" {...data} />
              ) : (
                <LinkblogCard {...data} />
              ))
          )
        }
      </ul>
    </section>

    <div class="my-8 text-center">
      <LinkButton href="/posts/">
        All Posts
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
      <LinkButton href="/links/" class="ms-4">
        All Links
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>

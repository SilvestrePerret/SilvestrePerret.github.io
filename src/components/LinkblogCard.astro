---
import type { CollectionEntry } from "astro:content";
import Datetime from "./Datetime.astro";

export type Props = CollectionEntry<"linkblog">;

const { data } = Astro.props;
const { title, sourceUrl, pubDatetime, quote, comment, via } = data;

const viaUrl = via && URL.canParse(via) ? via : undefined;
---

<li class="my-8 border-s-2 border-accent/50 ps-5">
  <a
    href={sourceUrl}
    target="_blank"
    rel="noreferrer"
    class="text-lg font-medium text-accent decoration-dashed underline-offset-4 hover:underline focus-visible:no-underline focus-visible:underline-offset-0"
  >
    {title}
  </a>
  <Datetime {pubDatetime} timezone={undefined} modDatetime={undefined} />
  {
    quote && (
      <blockquote class="mt-3 border-s-2 border-border ps-4 italic opacity-90">
        {quote}
      </blockquote>
    )
  }
  {comment && <p class="mt-3 whitespace-pre-line">{comment}</p>}
  {
    via && (
      <p class="mt-3 text-sm opacity-80">
        via {viaUrl ? <a href={viaUrl}>{via}</a> : via}
      </p>
    )
  }
</li>
